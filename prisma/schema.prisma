model Pago{

  idPago Int @id @default(autoincrement()) @db.UnsignedInt @map("id_pago")
  fecha DateTime @db.Timestamp(0) 
  estado String @db.VarChar(50)
  metodoPago String @db.VarChar(50) @map("metodo_pago")
  montoPagado Decimal @db.Decimal(12,0) @map("monto_pagado")

  pagoVentaOrdenDeTrabajo PagoVentaOrdenDeTrabajo[]

  @@map("pagos")

}

model PagoVentaOrdenDeTrabajo{

  idPagoVentaOrdenDeTrabajo Int @id @default(autoincrement()) @db.UnsignedInt @map("id_pago_venta_orden_de_trabajo")
  idPago Int @db.UnsignedInt @map("id_pago")
  idVenta Int? @db.UnsignedInt @map("id_venta")
  idOrdenDeTrabajo Int? @db.UnsignedInt @map("id_orden_de_trabajo")
  montoAsociado Decimal @db.Decimal(12,0) @map("monto_asociado")
  tipoAbono String @db.VarChar(50) @map("tipo_abono")

  venta Venta? @relation(fields: [idVenta], references: [idVenta])
  ordenDeTrabajo OrdenDeTrabajo? @relation(fields: [idOrdenDeTrabajo], references: [idOrdenDeTrabajo])
  pago Pago @relation(fields: [idPago], references: [idPago])

  @@map("pago_venta_oden_de_trabajo")

}

model Comprobante{

  idComprobante Int @id @default(autoincrement()) @db.UnsignedInt @map("id_comprobante")
  idCliente Int? @db.UnsignedInt @map("id_cliente")
  idOrdenDeCompra Int? @db.UnsignedInt @map("id_orden_de_compra")
  tipoMovimiento String @db.VarChar(20) @map("tipo_movimiento")
  tipoDte Int @db.SmallInt @map("tipo_dte")
  numeroFolio Int @db.UnsignedInt @unique @map("numero_folio")
  fechaEmision DateTime @db.Timestamp(0) @map("fecha_emision")
  montoNeto Decimal @db.Decimal(12,0) @map("monto_neto")
  montoIva Decimal @db.Decimal(12,0) @map("monto_iva")
  montoTotal Decimal @db.Decimal(12,0) @map("monto_total")

  ordendecompra OrdenDeCompra? @relation(fields: [idOrdenDeCompra], references: [idOrdenDeCompra])
  cliente Cliente? @relation(fields: [idCliente], references: [idCliente])

  @@map("comprobantes")

}

model AjusteInventario {
  idAjusteInventario Int @id @default(autoincrement()) @db.UnsignedInt @map("id_ajuste_inventario")
  idUsuario Int @db.UnsignedInt @map("id_usuario")
  fechaRegistro DateTime @db.Timestamp(0) @map("fecha_registro")
  motivo String @db.VarChar(255)

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  lineasDeAjuste LineaDeAjuste[]

  @@map("ajustes_inventario")

}

model LineaDeAjuste {
  idLineaDeAjuste Int @id @default(autoincrement()) @db.UnsignedInt @map("id_linea_de_ajuste")
  idAjusteInventario Int @db.UnsignedInt @map("id_ajuste_inventario")
  idProducto Int @db.UnsignedInt @map("id_producto")
  cantidad Int @db.UnsignedInt
  costoUnitario Decimal @db.Decimal(12,4) @map("costo_unitario")

  ajusteInventario AjusteInventario @relation(fields: [idAjusteInventario], references: [idAjusteInventario])
  producto Producto @relation(fields: [idProducto], references: [idProducto])

}

