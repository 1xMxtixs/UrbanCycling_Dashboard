// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Permiso {
  idPermiso Int @id @default(autoincrement()) @db.UnsignedInt @map("id_permiso")
  nombre String @db.VarChar(50) @unique
  modulo String @db.VarChar(50)
  recurso String @db.VarChar(50)
  accion String @db.VarChar(50)
  codigo String @db.VarChar(150) @unique
  descripcion String? @db.VarChar(255)

  rolesPermiso RolPermiso[]

  @@unique([modulo, recurso, accion], name: "permiso_unico_modulo_recurso_accion")

  @@map("permisos")
}

model Rol {
  idRol Int @id @default(autoincrement()) @db.UnsignedInt @map("id_rol")
  nombre String @db.VarChar(50) @unique
  descripcion String @db.VarChar(255)

  usuarios Usuario[]
  permisosRol RolPermiso[]

  @@map("roles")
}

model RolPermiso {
  idRolPermiso Int @id @default(autoincrement()) @db.UnsignedInt @map("id_rol_permiso")
  idRol Int @db.UnsignedInt @map("id_rol")
  idPermiso Int @db.UnsignedInt @map("id_permiso")
  fechaAsignacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_asignacion")

  rol Rol @relation(fields: [idRol], references: [idRol])
  permiso Permiso @relation(fields: [idPermiso], references: [idPermiso])

  @@unique([idRol, idPermiso], name: "rol_permiso_unico")

  @@map("rol_permiso")
}

model Usuario {
  idUsuario         Int       @id @default(autoincrement()) @db.UnsignedInt @map("id_usuario")
  idRol             Int       @db.UnsignedInt @map("id_rol")
  primerNombre      String    @db.VarChar(50)  @map("primer_nombre")
  segundoNombre     String?   @db.VarChar(50)  @map("segundo_nombre")
  apellidoPaterno   String    @db.VarChar(50)  @map("apellido_paterno")
  apellidoMaterno   String    @db.VarChar(50)  @map("apellido_materno")
  rut               String    @db.VarChar(12)  @unique
  correoElectronico String    @db.VarChar(100) @unique @map("correo_electronico")
  contrasena         String   @db.VarChar(255)
  fechaCreacion      DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")
  ultimoAcceso       DateTime? @db.Timestamp(0) @map("ultimo_acceso")
  tokenRecuperacion String?   @db.VarChar(255) @map("token_recuperacion")
  estado            String    @db.VarChar(20)

  rol                       Rol                    @relation(fields: [idRol], references: [idRol])
  ventas                    Venta[]
  ordenesDeTrabajo          OrdenDeTrabajo[]
  ordenesDeCompra           OrdenDeCompra[]
  ajustesInventario         AjusteInventario[]
  pagos                     Pago[]
  auditorias                Auditoria[]

  @@map("usuarios")
}


model Auditoria {
  idAuditoria BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id_auditoria")
  idUsuario Int @db.UnsignedInt @map("id_usuario")
  tipoOperacion String @db.VarChar(50) @map("tipo_operacion")
  nombreTablaAfectada String @db.VarChar(100) @map("nombre_tabla_afectada")
  registroAfectado Int @db.UnsignedInt @map("registro_afectado")
  valorAnterior Json? @map("valor_anterior")
  valorNuevo Json? @map("valor_nuevo")
  detalleCambio String? @db.VarChar(500) @map("detalle_cambio")
  fechaRegistro DateTime @default(now()) @db.Timestamp(0) @map("fecha_registro")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])

  @@map("auditoria")
}

model Cliente {
  idCliente       Int      @id @default(autoincrement()) @db.UnsignedInt @map("id_cliente")
  tipoCliente     String   @db.VarChar(20)  @map("tipo_cliente")
  rut             String   @db.VarChar(12)  @unique
  estado          String   @db.VarChar(20)
  primerNombre    String?  @db.VarChar(50)  @map("primer_nombre")
  segundoNombre   String?  @db.VarChar(50)  @map("segundo_nombre")
  apellidoPaterno String?  @db.VarChar(50)  @map("apellido_paterno")
  apellidoMaterno String?  @db.VarChar(50)  @map("apellido_materno")
  razonSocial     String?  @db.VarChar(255) @map("razon_social")
  giro            String?  @db.VarChar(100)
  nombreContacto  String?  @db.VarChar(100) @map("nombre_contacto")
  fechaCreacion   DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")

  ventas      Venta[]
  ordenesDeTrabajo OrdenDeTrabajo[]
  telefonos   TelefonoCliente[]
  direcciones DireccionCliente[]

  @@map("clientes")
}


model TelefonoCliente{

  idTelefonoCliente Int @id @default(autoincrement()) @db.UnsignedInt @map("id_telefono_cliente")
  idCliente Int @db.UnsignedInt @map("id_cliente")
  telefono String @db.VarChar(20) 
  descripcion String? @db.VarChar(50)

  cliente Cliente @relation(fields: [idCliente], references: [idCliente])

  @@map("telefonos_clientes")

}

model DireccionCliente{

  idDireccionCliente Int @id @default(autoincrement()) @db.UnsignedInt @map("id_direccion_cliente")
  idCliente Int @db.UnsignedInt @map("id_cliente")
  region String @db.VarChar(50) 
  ciudad String @db.VarChar(50)
  comuna String @db.VarChar(50)
  calle String @db.VarChar(150)
  numero String @db.VarChar(20)
  unidad String? @db.VarChar(20)
  descripcion String @db.VarChar(50)


  cliente Cliente @relation(fields: [idCliente], references: [idCliente])

  @@map("direcciones_clientes")
}

model Proveedor{

  idProveedor Int @id @default(autoincrement()) @db.UnsignedInt @map("id_proveedor")
  razonSocial String @db.VarChar(100) @map("razon_social")
  nombreFantasia String? @db.VarChar(150) @map("nombre_fantasia")
  rut String @db.VarChar(12) @unique
  giro String @db.VarChar(100)
  condicionesDePago String @db.VarChar(100) @map("condiciones_de_pago")
  nombreContacto String? @db.VarChar(100) @map("nombre_contacto")
  fechaRegistro DateTime @default(now()) @db.Timestamp(0) @map("fecha_registro")
  estado String @db.VarChar(20) 

  telefonos TelefonoProveedor[]
  correos CorreoProveedor[]
  direcciones DireccionProveedor[]
  ordenesDeCompra OrdenDeCompra[]

  @@map("proveedores")
}

model TelefonoProveedor{

  idTelefonoProveedor Int @id @default(autoincrement()) @db.UnsignedInt @map("id_telefono_proveedor")
  idProveedor Int @db.UnsignedInt @map("id_proveedor")
  telefono String @db.VarChar(20) 
  descripcion String? @db.VarChar(50) 

  proveedor Proveedor @relation(fields: [idProveedor], references: [idProveedor])

  @@map("telefonos_proveedor")
}

model CorreoProveedor{

  idCorreoProveedor Int @id @default(autoincrement()) @db.UnsignedInt @map("id_correo_proveedor")
  idProveedor Int @db.UnsignedInt @map("id_proveedor")
  correo String @db.VarChar(255)
  descripcion String? @db.VarChar(50) 

  proveedor Proveedor @relation(fields: [idProveedor], references: [idProveedor])

  @@map("correos_proveedores")
}

model DireccionProveedor{

  idDireccionProveedor Int @id @default(autoincrement()) @db.UnsignedInt @map("id_direccion_proveedor")
  idProveedor Int @db.UnsignedInt @map("id_proveedor")
  region String @db.VarChar(100) 
  ciudad String @db.VarChar(100)
  comuna String @db.VarChar(100)
  calle String @db.VarChar(150)
  numero String @db.VarChar(20)
  unidad String? @db.VarChar(20)
  descripcion String @db.VarChar(50)

  proveedor Proveedor @relation(fields: [idProveedor], references: [idProveedor])

  @@map("direcciones_proveedores")
}

model Servicio {
  idServicio Int @id @default(autoincrement()) @db.UnsignedInt @map("id_servicio")
  nombre String @db.VarChar(100) @unique
  descripcion String? @db.VarChar(500)
  precioVenta Decimal @db.Decimal(12, 0) @map("precio_venta")
  estado String @db.VarChar(20)

  productosServicio ProductoServicio[]
  lineasDeOrdenDeTrabajo LineaDeOrdenDeTrabajo[]

  @@map("servicios")
}

model ProductoServicio {
  idProductoServicio Int @id @default(autoincrement()) @db.UnsignedInt @map("id_producto_servicio")
  idProducto Int @db.UnsignedInt @map("id_producto")
  idServicio Int @db.UnsignedInt @map("id_servicio")
  cantidad Int @db.UnsignedSmallInt

  producto Producto @relation(fields: [idProducto], references: [idProducto])
  servicio Servicio @relation(fields: [idServicio], references: [idServicio])

  @@map("producto_servicio")
}

model Venta {
  idVenta       Int      @id @default(autoincrement()) @db.UnsignedInt @map("id_venta")
  idUsuario     Int      @db.UnsignedInt @map("id_usuario")
  idCliente     Int      @db.UnsignedInt @map("id_cliente")
  idComprobante Int?     @db.UnsignedInt @map("id_comprobante")
  total         Decimal  @db.Decimal(12, 0)
  descuento     Int      @db.UnsignedSmallInt
  estadoPago    String   @db.VarChar(50) @map("estado_pago")
  estado        String   @db.VarChar(20) @map("estado_venta")
  fechaCreacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")

  usuario              Usuario             @relation(fields: [idUsuario], references: [idUsuario])
  cliente              Cliente             @relation(fields: [idCliente], references: [idCliente])
  lineasDeVenta        LineaDeVenta[]
  asignacionesPago     AsignacionPago[]
  reclamosComoReclamada ReclamoGarantia[] @relation("VentaReclamada")
  reclamosComoGenerada  ReclamoGarantia[] @relation("VentaGenerada")
  origenesDTE          OrigenDocumentoTributario[]

  @@map("ventas")
}


model Producto {
  idProducto    Int     @id @default(autoincrement()) @db.UnsignedInt @map("id_producto")
  tipoProducto  String  @db.VarChar(50)  @map("tipo_producto")
  nombre        String  @db.VarChar(100) @unique
  descripcion   String? @db.VarChar(255)
  estado        String  @db.VarChar(20)
  precioVenta   Decimal @db.Decimal(12, 0) @map("precio_venta")
  stockActual   Int     @db.SmallInt @map("stock_actual")
  stockMinimo   Int     @db.SmallInt @map("stock_minimo")

  serviciosProducto      ProductoServicio[]
  categoriasProducto     CategoriaProducto[]
  lineasDeVenta          LineaDeVenta[]
  lineasDeOrdenDeTrabajo LineaDeOrdenDeTrabajo[]
  lineasDeOrdenDeCompra  LineaDeOrdenDeCompra[]
  lineasDeAjuste         LineaDeAjuste[]

  @@map("productos")
}


model Categoria{

  idCategoria Int @id @default(autoincrement()) @db.UnsignedInt @map("id_categoria")
  nombre String @db.VarChar(50) @unique
  descripcion String? @db.VarChar(255)
  estado String @db.VarChar(20)

  categoriasproducto CategoriaProducto[]

  @@map("categorias")
}

model CategoriaProducto{

  idCategoriaProducto Int @id @default(autoincrement()) @db.UnsignedInt @map("id_categoria_producto")
  idProducto Int @db.UnsignedInt @map("id_producto")
  idCategoria Int @db.UnsignedInt @map("id_categoria")
  fechaAsignacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_asignacion")

  producto Producto @relation(fields: [idProducto], references: [idProducto])
  categoria Categoria @relation(fields: [idCategoria], references: [idCategoria])

  @@map("categoria_producto")

}

model OrdenDeTrabajo {
  idOrdenDeTrabajo Int @id @default(autoincrement()) @db.UnsignedInt @map("id_orden_de_trabajo")
  idUsuario Int @db.UnsignedInt @map("id_usuario")
  idCliente Int @db.UnsignedInt @map("id_cliente")
  idComprobante Int? @db.UnsignedInt @map("id_comprobante")
  fechaRegistro DateTime @default(now()) @db.Timestamp(0) @map("fecha_recepcion")
  estadoPago String @db.VarChar(50) @map("estado_pago")
  fechaEntregaEstimada DateTime @db.Timestamp(0) @map("fecha_entrega_estimada")
  fechaEntregaReal DateTime? @db.Timestamp(0) @map("fecha_entrega_real")
  observacionesIngreso String? @db.VarChar(255) @map("observaciones_ingreso")
  total Decimal @db.Decimal(12, 0)
  descuento Int @db.UnsignedSmallInt
  estadoOrden String @db.VarChar(50) @map("estado_orden")
  fechaCreacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  cliente Cliente @relation(fields: [idCliente], references: [idCliente])
  bicicletas Bicicleta[]
  lineasDeOrdenDeTrabajo LineaDeOrdenDeTrabajo[]


  @@map("ordenes_de_trabajo")
}

model Bicicleta {
  idBicicleta Int @id @default(autoincrement()) @db.UnsignedInt @map("id_bicicleta")
  idOrdenDeTrabajo Int @db.UnsignedInt @map("id_orden_de_trabajo")
  marca String @db.VarChar(50)
  modelo String @db.VarChar(50)
  color String @db.VarChar(50)
  descripcion String? @db.VarChar(500)
  imagenUrl String? @db.VarChar(512) @map("imagen_url")

  ordenDeTrabajo OrdenDeTrabajo  @relation(fields: [idOrdenDeTrabajo], references: [idOrdenDeTrabajo])
  imagenesBicicleta ImagenBicicleta[]

  @@map("bicicletas")
}


model ImagenBicicleta{

  idImagenBicicleta Int @id @default(autoincrement()) @db.UnsignedInt @map("id_imagen_bicicleta")
  idBicicleta Int @db.UnsignedInt @map("id_bicicleta")
  url String @db.VarChar(512)

  bicicleta Bicicleta @relation(fields: [idBicicleta], references: [idBicicleta])

  @@map("imagenes_bicicleta")
}

model LineaDeVenta {
  idLineaDeVenta Int @id @default(autoincrement()) @db.UnsignedInt @map("id_linea_de_venta")
  idVenta Int @db.UnsignedInt @map("id_venta")
  idProducto Int @db.UnsignedInt @map("id_producto")
  cantidad Int @db.UnsignedSmallInt
  precioUnitario Decimal @db.Decimal(12, 0) @map("precio_unitario")

  producto Producto @relation(fields: [idProducto], references: [idProducto])
  venta Venta @relation(fields: [idVenta], references: [idVenta])
  movimientosInventario MovimientoInventario[]


  @@map("lineas_de_venta")
}

model LineaDeOrdenDeTrabajo {
  idLineaDeOrdenDeTrabajo Int @id @default(autoincrement()) @db.UnsignedInt @map("id_linea_de_orden_de_trabajo")
  idOrdenDeTrabajo Int @db.UnsignedInt @map("id_orden_de_trabajo")
  idServicio Int? @db.UnsignedInt @map("id_servicio")
  idProducto Int? @db.UnsignedInt @map("id_producto")
  cantidad Int @db.UnsignedSmallInt
  precioUnitario Decimal @db.Decimal(12, 0) @map("precio_unitario")

  ordenDeTrabajo OrdenDeTrabajo @relation(fields: [idOrdenDeTrabajo], references: [idOrdenDeTrabajo])
  servicio Servicio? @relation(fields: [idServicio], references: [idServicio])
  producto Producto? @relation(fields: [idProducto], references: [idProducto])
  movimientosInventario MovimientoInventario[]

  @@map("lineas_de_orden_de_trabajo")
}

model ReclamoGarantia {
  idReclamoGarantia       Int      @id @default(autoincrement()) @db.UnsignedInt @map("id_reclamo_garantia")
  idVentaReclamada        Int     @db.UnsignedInt @map("id_venta_reclamada")
  idVentaGenerada         Int?     @db.UnsignedInt @unique @map("id_venta_generada")
  fechaRegistro           DateTime @default(now()) @db.Timestamp(0) @map("fecha_registro")
  estado                  String   @db.VarChar(20)
  motivo                  String   @db.VarChar(500)
  tipoResolucion          String?  @db.VarChar(30)  @map("tipo_resolucion")
  justificacionResolucion String?  @db.VarChar(500) @map("justificacion_resolucion")

  ventaReclamada Venta @relation("VentaReclamada", fields: [idVentaReclamada], references: [idVenta])
  ventaGenerada  Venta? @relation("VentaGenerada",  fields: [idVentaGenerada],  references: [idVenta])

  @@map("reclamos_garantia")
}


model OrdenDeCompra {
  idOrdenDeCompra      Int       @id @default(autoincrement()) @db.UnsignedInt @map("id_orden_de_compra")
  idUsuario            Int       @db.UnsignedInt @map("id_usuario")
  idProveedor          Int       @db.UnsignedInt @map("id_proveedor")
  fechaRegistro        DateTime  @default(now()) @db.Timestamp(0) @map("fecha_registro")
  estado               String    @db.VarChar(20)
  estadoPago           String    @db.VarChar(20) @map("estado_pago")
  estadoRecepcion      String    @db.VarChar(20) @map("estado_recepcion")
  fechaEntregaEstimada DateTime  @db.Date         @map("fecha_entrega_estimada")
  fechaEntregaReal     DateTime? @db.Timestamp(0) @map("fecha_entrega_real")
  montoSubtotal        Decimal   @db.Decimal(12, 0) @map("monto_subtotal")
  descuentoProductos   Decimal   @db.Decimal(12, 0) @map("descuento_productos")
  descuentoGlobal      Decimal   @db.Decimal(12, 0) @map("descuento_global")
  montoTotal           Decimal   @db.Decimal(12, 0) @map("monto_total")
  montoNeto            Decimal   @db.Decimal(12, 0) @map("monto_neto")
  montoIva             Decimal   @db.Decimal(12, 0) @map("monto_iva")

  usuario          Usuario                    @relation(fields: [idUsuario],   references: [idUsuario])
  proveedor        Proveedor                  @relation(fields: [idProveedor], references: [idProveedor])
  lineas           LineaDeOrdenDeCompra[]
  asignacionesPago AsignacionPago[]
  origenesDTE      OrigenDocumentoTributario[]

  @@map("ordenes_de_compra")
}

model LineaDeOrdenDeCompra {
  idLineaDeOrdenDeCompra Int     @id @default(autoincrement()) @db.UnsignedInt @map("id_linea_de_orden_de_compra")
  idOrdenDeCompra        Int     @db.UnsignedInt @map("id_orden_de_compra")
  idProducto             Int     @db.UnsignedInt @map("id_producto")
  cantidadOrdenada       Int     @db.UnsignedInt @map("cantidad_ordenada")
  cantidadRecibida       Int     @db.UnsignedInt @map("cantidad_recibida")
  precioCostoUnitario    Decimal @db.Decimal(12, 4) @map("precio_costo_unitario")

  ordenDeCompra         OrdenDeCompra @relation(fields: [idOrdenDeCompra], references: [idOrdenDeCompra])
  producto              Producto      @relation(fields: [idProducto],      references: [idProducto])
  movimientosInventario MovimientoInventario[]

  @@map("lineas_de_orden_de_compra")
}


model Pago {
  idPago        Int      @id @default(autoincrement()) @db.UnsignedInt @map("id_pago")
  idUsuario     Int      @db.UnsignedInt @map("id_usuario")
  fechaRegistro DateTime @db.Timestamp(0) @map("fecha_registro")
  estado        String   @db.VarChar(20)
  metodoPago    String   @db.VarChar(20)  @map("metodo_pago")
  monto         Decimal  @db.Decimal(12, 0)

  usuario      Usuario          @relation(fields: [idUsuario], references: [idUsuario])
  asignaciones AsignacionPago[]

  @@map("pagos")
}


model AsignacionPago {
  idAsignacionPago   Int     @id @default(autoincrement()) @db.UnsignedInt @map("id_asignacion_pago")
  idPago             Int     @db.UnsignedInt @map("id_pago")
  idVenta            Int?    @db.UnsignedInt @map("id_venta")
  idOrdenDeCompra    Int?    @db.UnsignedInt @map("id_orden_de_compra")
  montoAsociado      Decimal @db.Decimal(12, 0) @map("monto_asociado")
  tipoAbono          String  @db.VarChar(50) @map("tipo_abono")

  pago             Pago              @relation(fields: [idPago],             references: [idPago])
  venta            Venta?            @relation(fields: [idVenta], references: [idVenta])
  ordenDeCompra    OrdenDeCompra?    @relation(fields: [idOrdenDeCompra],    references: [idOrdenDeCompra])

  @@map("asignaciones_pago")
}


model DocumentoTributario {
  idDocumentoTributario Int      @id @default(autoincrement()) @db.UnsignedInt @map("id_documento_tributario")
  idUsuario             Int      @db.UnsignedInt @map("id_usuario")
  idCliente             Int?     @db.UnsignedInt @map("id_cliente")
  tipoMovimiento        String   @db.VarChar(20)   @map("tipo_movimiento")
  tipoDte               Int      @db.UnsignedSmallInt @map("tipo_dte")
  numeroFolio           Int      @db.UnsignedInt   @map("numero_folio")
  rutEmisor             String   @db.VarChar(12)   @map("rut_emisor")
  rutReceptor           String   @db.VarChar(12)   @map("rut_receptor")
  fechaRegistro         DateTime @default(now()) @db.Timestamp(0) @map("fecha_registro")
  fechaEmision          DateTime @db.Date           @map("fecha_emision")
  montoSubtotal         Decimal  @db.Decimal(12, 0) @map("monto_subtotal")
  descuentoAcumulado    Decimal  @db.Decimal(12, 0) @map("descuento_acumulado")
  montoTotal            Decimal  @db.Decimal(12, 0) @map("monto_total")
  montoNeto             Decimal  @db.Decimal(12, 0) @map("monto_neto")
  montoIva              Decimal  @db.Decimal(12, 0) @map("monto_iva")
  estado                String   @db.VarChar(20)
  urlPdf                String?  @db.VarChar(512)   @map("url_pdf")

  origenes     OrigenDocumentoTributario[]
  referencias  ReferenciaDte[] @relation("DteOrigen")
  referenciado ReferenciaDte[] @relation("DteReferenciado")

  @@map("documentos_tributarios")
}



model AjusteInventario {
  idAjusteInventario Int      @id @default(autoincrement()) @db.UnsignedInt @map("id_ajuste_inventario")
  idUsuario          Int      @db.UnsignedInt @map("id_usuario")
  fechaRegistro      DateTime @db.Timestamp(0) @map("fecha_registro")
  motivo             String   @db.VarChar(50)
  direccion          String   @db.VarChar(20)
  observacion        String?  @db.VarChar(500)

  usuario Usuario         @relation(fields: [idUsuario], references: [idUsuario])
  lineas  LineaDeAjuste[]

  @@map("ajustes_inventario")
}


model LineaDeAjuste {
  idLineaDeAjuste    Int     @id @default(autoincrement()) @db.UnsignedInt @map("id_linea_de_ajuste")
  idAjuste           Int     @db.UnsignedInt @map("id_ajuste")
  idProducto         Int     @db.UnsignedInt @map("id_producto")
  cantidad           Int     @db.UnsignedInt
  cantidadAnterior   Int     @db.UnsignedInt @map("cantidad_anterior")
  cantidadNueva      Int     @db.UnsignedInt @map("cantidad_nueva")
  costoUnitario      Decimal @db.Decimal(12, 4) @map("costo_unitario")

  ajusteInventario AjusteInventario @relation(fields: [idAjuste],     references: [idAjusteInventario])
  producto         Producto         @relation(fields: [idProducto],   references: [idProducto])
  movimientosInventario MovimientoInventario[]

  @@map("lineas_de_ajuste")
}


model MovimientoInventario {
  idMovimientoInventario  Int      @id @default(autoincrement()) @db.UnsignedInt @map("id_movimiento_inventario")
  idLineaDeOrdenDeCompra  Int?     @db.UnsignedInt @map("id_linea_de_orden_de_compra")
  idLineaDeOrdenDeTrabajo Int?     @db.UnsignedInt @map("id_linea_de_orden_de_trabajo")
  idLineaDeVenta          Int?     @db.UnsignedInt @map("id_linea_de_venta")
  idLineaDeAjuste         Int?     @db.UnsignedInt @map("id_linea_de_ajuste")
  fechaRegistro           DateTime @default(now()) @db.Timestamp(0) @map("fecha_registro")
  tipoMovimiento          String   @db.VarChar(20) @map("tipo_movimiento")
  cantidad                Int      @db.UnsignedInt
  costoUnitario           Decimal  @db.Decimal(12, 4) @map("costo_unitario")

  lineaDeOrdenDeCompra  LineaDeOrdenDeCompra?  @relation(fields: [idLineaDeOrdenDeCompra],  references: [idLineaDeOrdenDeCompra])
  lineaDeOrdenDeTrabajo LineaDeOrdenDeTrabajo? @relation(fields: [idLineaDeOrdenDeTrabajo], references: [idLineaDeOrdenDeTrabajo])
  lineaDeVenta          LineaDeVenta?          @relation(fields: [idLineaDeVenta],          references: [idLineaDeVenta])
  lineaDeAjuste         LineaDeAjuste?         @relation(fields: [idLineaDeAjuste],         references: [idLineaDeAjuste])

  @@map("movimientos_inventario")
}


model OrigenDocumentoTributario {
  idOrigenDocumentoTributario Int  @id @default(autoincrement()) @db.UnsignedInt @map("id_origen_documento_tributario")
  idDocumentoTributario       Int  @db.UnsignedInt @map("id_documento_tributario")
  idVenta                     Int? @db.UnsignedInt @map("id_venta")
  idOrdenDeCompra             Int? @db.UnsignedInt @map("id_orden_de_compra")
  fechaRegistro               DateTime @default(now()) @db.Timestamp(0) @map("fecha_registro")


  documentoTributario DocumentoTributario @relation(fields: [idDocumentoTributario], references: [idDocumentoTributario])
  venta               Venta?              @relation(fields: [idVenta],              references: [idVenta])
  ordenDeCompra       OrdenDeCompra?      @relation(fields: [idOrdenDeCompra],       references: [idOrdenDeCompra])

  @@map("origen_documentos_tributarios")
}

model ReferenciaDte {
  idReferenciaDte   Int      @id @default(autoincrement()) @db.UnsignedInt @map("id_referencia_dte")
  idDteOriginador   Int      @db.UnsignedInt @map("id_dte_originador")
  idDteReferenciado Int      @db.UnsignedInt @map("id_dte_referenciado")
  codigoReferencia  Int      @db.UnsignedTinyInt @map("codigo_referencia")
  razonReferencia   String   @db.VarChar(90) @map("razon_referencia")
  fechaReferencia   DateTime @db.Date @map("fecha_referencia")

  dteOriginador   DocumentoTributario @relation("DteOrigen", fields: [idDteOriginador],   references: [idDocumentoTributario])
  dteReferenciado DocumentoTributario @relation("DteReferenciado", fields: [idDteReferenciado],  references: [idDocumentoTributario])

  @@map("referencias_dte")
}


