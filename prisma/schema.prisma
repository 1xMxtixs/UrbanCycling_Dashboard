  idBicicleta Int @db.UnsignedInt @map("id_bicicleta")
  url String @db.VarChar(512)

  bicicleta Bicicleta @relation(fields: [idBicicleta], references: [idBicicleta])

  @@map("imagenes_bicicleta")
}

