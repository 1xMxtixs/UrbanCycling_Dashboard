// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Rol {
  idRol Int @id @default(autoincrement()) @db.UnsignedInt @map("id_rol")
  nombre String @db.VarChar(50) @unique
  descripcion String @db.VarChar(255)

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  idUsuario Int @id @default(autoincrement()) @db.UnsignedInt @map("id_usuario")
  idRol Int @db.UnsignedInt @map("id_rol")
  primerNombre String @db.VarChar(50) @map("primer_nombre")
  segundoNombre String? @db.VarChar(50) @map("segundo_nombre")
  apellidoPaterno String @db.VarChar(50) @map("apellido_paterno")
  apellidoMaterno String @db.VarChar(50) @map("apellido_materno")
  rut String @db.VarChar(12) @unique
  correoElectronico String @db.VarChar(100) @unique @map("correo_electronico")
  contrasena String @db.VarChar(255) 
  estado String @db.VarChar(20)
  fechaCreacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")
  ultimoAcceso DateTime? @db.Timestamp(0) @map("ultimo_acceso")
  tokenRecuperacion String? @db.VarChar(255) @map("token_recuperacion")

  rol Rol @relation(fields: [idRol], references: [idRol])
  ordenesDeTrabajo OrdenDeTrabajo[]

  ventas Venta[]

  @@map("usuarios")
}

model Cliente {
  idCliente Int @id @default(autoincrement()) @db.UnsignedInt @map("id_cliente")
  tipoCliente String @db.VarChar(20) @map("tipo_cliente")
  rut String @db.VarChar(12) @unique
  primerNombre String? @db.VarChar(50) @map("primer_nombre")
  segundoNombre String? @db.VarChar(50) @map("segundo_nombre")
  apellidoPaterno String? @db.VarChar(50) @map("apellido_paterno")
  apellidoMaterno String? @db.VarChar(50) @map("apellido_materno")
  razonSocial String? @db.VarChar(255) @map("razon_social")
  giro String? @db.VarChar(100)
  nombreContacto String? @db.VarChar(100) @map("nombre_contacto")
  estado String @db.VarChar(20)
  fechaCreacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")

  ventas Venta[]
  telefonos TelefonoCliente[]
  correos CorreoCliente[]
  direcciones DireccionCliente[]
  ordenesDeTrabajo OrdenDeTrabajo[]

  @@map("clientes")
}

model TelefonoCliente{

  idTelefonoCliente Int @id @default(autoincrement()) @db.UnsignedInt @map("id_telefono_cliente")
  idCliente Int @db.UnsignedInt @map("id_cliente")
  telefono String @db.VarChar(20) 
  descripcion String? @db.VarChar(50)

  cliente Cliente @relation(fields: [idCliente], references: [idCliente])

  @@map("telefonos_clientes")

}

model CorreoCliente{

  idCorreoCliente Int @id @default(autoincrement()) @db.UnsignedInt @map("id_correo_cliente")
  idCliente Int @db.UnsignedInt @map("id_cliente")
  correo String @db.VarChar(100) @unique
  descripcion String? @db.VarChar(50)

  cliente Cliente @relation(fields: [idCliente], references: [idCliente])

  @@map("correos_clientes")

}

model DireccionCliente{

  idDireccionCliente Int @id @default(autoincrement()) @db.UnsignedInt @map("id_direccion_cliente")
  idCliente Int @db.UnsignedInt @map("id_cliente")
  region String @db.VarChar(50) 
  ciudad String @db.VarChar(50)
  comuna String @db.VarChar(50)
  calle String @db.VarChar(150)
  numero String @db.VarChar(20)
  unidad String? @db.VarChar(20)

  cliente Cliente @relation(fields: [idCliente], references: [idCliente])

  @@map("direcciones_clientes")
}

model Proveedor{

  idProveedor Int @id @default(autoincrement()) @db.UnsignedInt @map("id_proveedor")
  razonSocial String @db.VarChar(100) @map("razon_social")
  nombreFantasia String? @db.VarChar(150) @map("nombre_fantasia")
  rut String @db.VarChar(12) @unique
  giro String @db.VarChar(100)
  condicionesDePago String @db.VarChar(100) @map("condiciones_de_pago")
  nombreContacto String? @db.VarChar(100) @map("nombre_contacto")
  fechaCreacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")
  estado String @db.VarChar(20) 

  telefonos TelefonoProveedor[]
  correos CorreoProveedor[]
  direcciones DireccionProveedor[]

  @@map("proveedores")
}

model TelefonoProveedor{

  idTelefonoProveedor Int @id @default(autoincrement()) @db.UnsignedInt @map("id_telefono_proveedor")
  idProveedor Int @db.UnsignedInt @map("id_proveedor")
  telefono String @db.VarChar(20) 
  descripcion String? @db.VarChar(50) 

  proveedor Proveedor @relation(fields: [idProveedor], references: [idProveedor])

  @@map("telefonos_proveedor")
}

model CorreoProveedor{

  idCorreoProveedor Int @id @default(autoincrement()) @db.UnsignedInt @map("id_correo_proveedor")
  idProveedor Int @db.UnsignedInt @map("id_proveedor")
  telefono String @db.VarChar(20)
  descripcion String? @db.VarChar(50) 

  proveedor Proveedor @relation(fields: [idProveedor], references: [idProveedor])

  @@map("correos_proveedores")
}

model DireccionProveedor{

  idDireccionProveedor Int @id @default(autoincrement()) @db.UnsignedInt @map("id_direccion_proveedor")
  idProveedor Int @db.UnsignedInt @map("id_proveedor")
  region String @db.VarChar(100) 
  ciudad String @db.VarChar(100)
  comuna String @db.VarChar(100)
  calle String @db.VarChar(150)
  numero String @db.VarChar(20)
  unidad String? @db.VarChar(20)

  proveedor Proveedor @relation(fields: [idProveedor], references: [idProveedor])

  @@map("direcciones_proveedores")
}

model Servicio {
  idServicio Int @id @default(autoincrement()) @db.UnsignedInt @map("id_servicio")
  nombre String @db.VarChar(100) @unique
  descripcion String? @db.VarChar(255)
  precioVenta Decimal @db.Decimal(12, 0) @map("precio_venta")
  estado String @db.VarChar(20)

  productosServicio ProductoServicio[]

  @@map("servicios")
}

model ProductoServicio {
  idProductoServicio Int @id @default(autoincrement()) @db.UnsignedInt @map("id_producto_servicio")
  idProducto Int @db.UnsignedInt @map("id_producto")
  idServicio Int @db.UnsignedInt @map("id_servicio")
  cantidad Int @db.UnsignedSmallInt
  precioUnitario Decimal @db.Decimal(12, 0) @map("precio_unitario")

  producto Producto @relation(fields: [idProducto], references: [idProducto])
  servicio Servicio @relation(fields: [idServicio], references: [idServicio])

  @@map("producto_servicio")
}

model Venta {
  idVenta Int @id @default(autoincrement()) @db.UnsignedInt @map("id_venta")
  idUsuario Int @db.UnsignedInt @map("id_usuario")
  idCliente Int @db.UnsignedInt @map("id_cliente")
  idComprobante Int? @db.UnsignedInt @map("id_comprobante")
  total Decimal @db.Decimal(12, 0)
  descuento Int @db.UnsignedSmallInt
  estadoPago String @db.VarChar(50) @map("estado_pago")
  estadoVenta String @db.VarChar(20) @map("estado_venta")
  fechaCreacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  cliente Cliente @relation(fields: [idCliente], references: [idCliente])

  @@map("ventas")
}

model Producto{
  idProducto Int @id @default(autoincrement()) @db.UnsignedInt @map("id_producto")
  tipoProducto String @db.VarChar(50) @map("tipo_producto")
  nombre String @db.VarChar(100) @unique
  descripcion String? @db.VarChar(255)
  precioVenta Decimal @db.Decimal(12, 0) @map("precio_venta")
  stockActual Int @db.SmallInt @map("stock_actual")
  stockMinimo Int @db.SmallInt @map("stock_minimo")
  estado String @db.VarChar(20)

  serviciosProducto ProductoServicio[]
  categoriasproducto CategoriaProducto[]

  @@map("productos")
}


model Categoria{

  idCategoria Int @id @default(autoincrement()) @db.UnsignedInt @map("id_categoria")
  nombre String @db.VarChar(50) @unique
  descripcion String? @db.VarChar(255)
  estado String? @db.VarChar(20)

  @@map("categorias")

  categoriasproducto CategoriaProducto[]

}

model CategoriaProducto{

  idCategoriaProducto Int @id @default(autoincrement()) @db.UnsignedInt @map("id_categoria_producto")
  idProducto Int @db.UnsignedInt @map("id_producto")
  idCategoria Int @db.UnsignedInt @map("id_categoria")
  fechaAsignacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_asignacion")
  estadoAsignacion String @db.VarChar(20) @map("estado_asignacion")

  producto Producto @relation(fields: [idProducto], references: [idProducto])
  categoria Categoria @relation(fields: [idCategoria], references: [idCategoria])

  @@map("categoria_producto")

}

model OrdenDeTrabajo {
  idOrdenDeTrabajo Int @id @default(autoincrement()) @db.UnsignedInt @map("id_orden_de_trabajo")
  idUsuario Int @db.UnsignedInt @map("id_usuario")
  idCliente Int @db.UnsignedInt @map("id_cliente")
  idComprobante Int? @db.UnsignedInt @map("id_comprobante")
  fechaRecepcion DateTime @default(now()) @db.Timestamp(0) @map("fecha_recepcion")
  fechaEntregaEstimada DateTime @db.Timestamp(0) @map("fecha_entrega_estimada")
  fechaEntregaReal DateTime? @db.Timestamp(0) @map("fecha_entrega_real")
  observacionesIngreso String? @db.VarChar(255) @map("observaciones_ingreso")
  total Decimal @db.Decimal(12, 0)
  descuento Int @db.UnsignedSmallInt
  estadoPago String @db.VarChar(50) @map("estado_pago")
  estadoOrden String @db.VarChar(50) @map("estado_orden")
  fechaCreacion DateTime @default(now()) @db.Timestamp(0) @map("fecha_creacion")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  cliente Cliente @relation(fields: [idCliente], references: [idCliente])
  bicicletas Bicicleta?

  @@map("ordenes_de_trabajo")
}

model Bicicleta{
  idBicicleta Int @id @default(autoincrement()) @db.UnsignedInt @map("id_bicicleta")
  idOrdenDeTrabajo Int @unique @db.UnsignedInt @map("id_orden_de_trabajo")
  marca String @db.VarChar(50)
  modelo String @db.VarChar(50)
  color String @db.VarChar(50)
  descripcion String? @db.VarChar(500)

  ordenDeTrabajo OrdenDeTrabajo @relation(fields: [idOrdenDeTrabajo], references: [idOrdenDeTrabajo])

  @@map("bicicletas")
}