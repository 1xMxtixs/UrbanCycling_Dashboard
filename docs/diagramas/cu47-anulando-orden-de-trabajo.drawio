        <mxCell id="nota" value="EX-1: si la orden está Entregada o Anulada, el paso 10 responde 409 con el código ANULACION_NO_PERMITIDA y la interfaz muestra &quot;No es posible anular esta orden&quot;. La orden no se modifica." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nota2" value="EX-4: los pasos 11 a 13 ocurren dentro de una misma transacción. Si falla cualquiera, se revierte el estado y la auditoría." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="510" y="840" width="440" height="90" as="geometry" />
